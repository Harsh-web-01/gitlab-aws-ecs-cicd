{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "LearnGitlabAppTo-Prod",
    "containerDefinitions": [
        {
            "name": "LearnGitlabApp",
            "image": "686348673799.dkr.ecr.ap-south-1.amazonaws.com/learngitlabapp",
            "portMappings": [{
                "name": "nginx-80-tcp",
                "containerPort": 80,
                "hostPort": 80,
                "protocol": "tcp",
                "appProtocol": "http"
            }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::686348673799:role/ecsTaskExecutionRole"
}